# Main blog site
yourdomain.com {
    root * /var/www/tao_blog
    file_server
    encode gzip

    # Cache static assets aggressively
    @static {
        path *.css *.js *.jpg *.jpeg *.png *.gif *.webp *.svg *.woff2 *.ico
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Cache HTML pages for a shorter time
    @html {
        path *.html /
    }
    header @html Cache-Control "public, max-age=3600"
}

# Remark42 comment system
comments.yourdomain.com {
    reverse_proxy localhost:8080
}
